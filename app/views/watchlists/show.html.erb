<div class="container py-5">
  <h1 class="h3 mb-4">★ My Watchlist</h1>

  <% if @movies.any? %>
    <div class="row">
      <% @movies.each do |movie| %>
        <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
          <div class="card h-100 shadow-sm">
            <% if movie.avatar.present? %>
              <%= image_tag(movie.avatar, class: "card-img-top", style: "height:260px;object-fit:cover;") %>
            <% else %>
              <%= image_tag("https://via.placeholder.com/300x440?text=No+Poster", class: "card-img-top") %>
            <% end %>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= movie.name %></h5>
              <p class="text-muted small mb-2"><%= movie.released_at&.year %></p>
              <%= link_to "View", movie, class: "btn btn-sm btn-outline-primary mt-auto" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      Your watchlist is empty. Browse <%= link_to "movies", movies_path %> and hit
      <strong>☆ Add to watchlist</strong> on any film.
    </div>
  <% end %>
</div>
