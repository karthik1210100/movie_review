<div class="container my-4">
  <div class="card p-3 shadow-sm">
    <%= form_with url: movies_path, method: :get do |form| %>
      <%= hidden_field_tag :genre, params[:genre] if params[:genre].present? %>
      <div class="row g-2 align-items-end">
        <div class="col-md-3">
          <%= label_tag :q, "Search", class: "form-label" %>
          <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "movie name" %>
        </div>

        <div class="col-md-2">
          <%= label_tag :sort, "Sort by", class: "form-label" %>
          <%= select_tag :sort,
                         options_for_select([["Top rated", "top"], ["Newest", "newest"], ["A–Z", "title"]], params[:sort]),
                         class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= form.label :start_date, "From", class: "form-label" %>
          <%= form.date_field :start_date, class: "form-control", value: params[:start_date] %>
        </div>

        <div class="col-md-2">
          <%= form.label :end_date, "To", class: "form-label" %>
          <%= form.date_field :end_date, class: "form-control", value: params[:end_date] %>
        </div>

        <div class="col-md-3 d-grid gap-2 d-md-flex">
          <%= form.submit "Apply", class: "btn btn-primary" %>
          <%= link_to "Reset", movies_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    <% end %>

    <% if @genres.present? %>
      <div class="mt-3">
        <span class="text-muted small me-2">Genres:</span>
        <% if params[:genre].present? %>
          <%= link_to "✕ #{params[:genre]}", movies_path(sort: params[:sort], q: params[:q]),
                      class: "badge rounded-pill bg-primary text-decoration-none me-1" %>
        <% end %>
        <% @genres.each do |tag| %>
          <% next if tag.name == params[:genre] %>
          <%= link_to tag.name, movies_path(genre: tag.name, sort: params[:sort], q: params[:q]),
                      class: "badge rounded-pill bg-light text-dark border text-decoration-none me-1" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
